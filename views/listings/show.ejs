<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = "<%- JSON.stringify(listing) %>" ;
    
</script>

<div class="row mt-3">
    <!-- Title -->
    <div class="col-8  offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card col-6 offset-3 show-card">
        <img src="<%= listing.image.url %>" 
        class="card-img-top show-img listing-card" 
        alt="listing_image">
    
        <div class="card-body">
            <p class="card-text">
                Owned by <i><%= listing.owner.username %></i>
            </p>
            <p class="card-text"><%= listing.description %></p>
            <p class="card-text">₹ <%= listing.price.toLocaleString("en-IN") %></p>
            <p class="card-text"><%= listing.location %></p>
            <p class="card-text"><%= listing.country %></p>
        </div>
    </div>

    <br/>
    <!-- Edit and delete buttons -->
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %> 

    <div class="btns">
        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
        <br/>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <% } %>

    <!-- review model form -->

    <!-- Create review -->

    <div class="col-8 offset-3 mb-3">
        <hr/>
        <% if(currUser){ %>

            <h4>Leave a review</h4>
            <form method="POST" action="/listings/<%= listing.id%>/reviews" class="needs-validation" novalidate>

                <!-- ⭐ STAR RATING -->
                <fieldset class="starability-slot mb-3">
                <legend>Rating:</legend>

                <input type="radio" id="rate1" name="review[rating]" value="1" required />
                <label for="rate1" title="Terrible">1 star</label>

                <input type="radio" id="rate2" name="review[rating]" value="2" />
                <label for="rate2" title="Not good">2 stars</label>

                <input type="radio" id="rate3" name="review[rating]" value="3" />
                <label for="rate3" title="Average">3 stars</label>

                <input type="radio" id="rate4" name="review[rating]" value="4" />
                <label for="rate4" title="Very good">4 stars</label>

                <input type="radio" id="rate5" name="review[rating]" value="5" />
                <label for="rate5" title="Amazing">5 stars</label>
                </fieldset>

                <!-- COMMENT -->
                <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea 
                    name="review[comment]" 
                    id="comment" 
                    rows="4" 
                    class="form-control"
                    required></textarea>

                <div class="invalid-feedback">
                    Please add some comments for review
                </div>
                </div>

                <button class="btn btn-outline-dark">Submit</button>
            </form>

            <hr/>
        <% } %>
         
        <!-- Show all review -->       
       
         
        
        <% if (listing.reviews.length > 0) { %> 
        <div class="row">
            <h5 class="mb-3"><b>All Reviews</b></h5>
            <% for(let review of listing.reviews){ %>
                <div class="card col-12 col-md-5 ms-md-3 mb-3">
                    <div class="card-body">

                        <!-- RESPONSIVE LAYOUT -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start">

                            <!-- LEFT -->
                            <div>
                                <h6 class="card-title">@<%= review.author.username %></h6>
                                <p class="card-text mb-1"><%= review.comment %></p>
                            </div>

                            <!-- RIGHT (STARS) -->
                            <div class="mt-2 mt-md-0">
                                <p class="starability-result card-text mb-0" data-rating="<%= review.rating %>"></p>
                            </div>

                        </div>

                        <!-- DELETE BUTTON -->
                        <% if(currUser && review.author._id.equals(currUser._id)){ %>
                        <form class="mt-2" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </form>
                        <% } %>

                    </div>
                </div>
            <% } %>
        </div>
        <% } %>     
    </div>
    <!-- Map div -->
    <div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>

<script src="/js/map.js"></script>